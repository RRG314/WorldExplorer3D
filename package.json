{
  "name": "worldexplorer3d",
  "version": "4.3.1",
  "description": "Browser-based 3D geospatial exploration app using OpenStreetMap-derived data for Earth and destination-mode exploration.",
  "type": "module",
  "main": "three.js",
  "scripts": {
    "dev": "node scripts/serve-local-preview.mjs",
    "candidate:create": "node scripts/local-candidate.mjs create",
    "candidate:serve": "node scripts/local-candidate.mjs serve",
    "candidate:create-and-serve": "node scripts/local-candidate.mjs create-and-serve",
    "verify:source": "node scripts/verification/source.mjs",
    "verify:provider-release": "node scripts/verification/provider-release.mjs",
    "verify:firestore-rules": "firebase emulators:exec --only firestore --project we3d-staging-20260712 \"node --test tests/firestore.rules.security.test.mjs\"",
    "verify:multiplayer": "firebase emulators:exec --only auth,firestore --project we3d-staging-20260712 \"node scripts/verification/multiplayer.mjs\"",
    "verify:world": "node scripts/verification/world.mjs",
    "verify:jfx-player-surface": "node scripts/verification/jfx-player-surface.mjs",
    "verify:environments": "node scripts/verification/environments.mjs",
    "verify:assembled-locations": "node scripts/verification/assembled-locations.mjs",
    "verify:actors-vehicles": "node scripts/verification/actors-vehicles.mjs",
    "verify:live-gps": "node scripts/verification/live-gps.mjs",
    "verify:shore-fishing": "node scripts/verification/shore-fishing.mjs",
    "verify:mobile-controls": "node scripts/verification/mobile-controls.mjs",
    "verify:retention-release": "node scripts/verification/retention-release.mjs",
    "verify:retention-ui": "node scripts/verification/retention-ui.mjs",
    "verify:performance-retention": "node scripts/verification/performance-retention.mjs",
    "verify:deflock": "node --test tests/deflock-data-contract.test.mjs",
    "verify:deflock-live-ui": "node scripts/verification/deflock-live-ui.mjs",
    "verify:walking-encounters": "node scripts/verification/walking-encounters.mjs",
    "verify:artifact-runtime": "WE3D_VERIFY_ROOT=dist node scripts/verification/world.mjs",
    "test": "npm run verify:source && npm run verify:world",
    "verify:pr": "npm run verify:source",
    "runtime:verify": "npm test",
    "firebase:config": "node scripts/apply-firebase-config.mjs",
    "firebase:config:production": "node scripts/apply-firebase-config.mjs production",
    "firebase:config:staging": "node scripts/apply-firebase-config.mjs staging",
    "build:hosting": "node scripts/hosting-artifact.mjs build",
    "verify:hosting": "node scripts/hosting-artifact.mjs verify",
    "audit:reachability": "node scripts/audit-hosting-reachability.mjs --strict",
    "audit:assets": "node scripts/audit-hosting-assets.mjs --strict",
    "audit:terrain-provider": "node scripts/audit-terrain-provider.mjs",
    "ground:artifact": "node scripts/build-ground-artifact.mjs",
    "ground:catalog": "node scripts/rebuild-ground-catalog.mjs",
    "ground:worldwide": "node scripts/build-worldwide-ground-artifacts.mjs",
    "ground:datum": "node scripts/run-ground-datum-normalizer.mjs",
    "data:landmarks": "node scripts/update-featured-landmarks.mjs",
    "data:buildings": "node scripts/update-preset-building-metadata.mjs",
    "release:verify": "node scripts/verification/release.mjs",
    "release:finalize": "node scripts/release-finalize.mjs",
    "preview:deploy": "node scripts/firebase-hosting-preview.mjs",
    "preview:promote": "node scripts/firebase-hosting-promote.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RRG314/WorldExplorer3D.git"
  },
  "keywords": [
    "openstreetmap",
    "osm",
    "geospatial",
    "mapping",
    "3d",
    "webgl",
    "threejs",
    "browser-app",
    "world-exploration",
    "web-game",
    "location-based-game",
    "gps",
    "multiplayer",
    "surveillance-awareness"
  ],
  "author": "Steven Reid",
  "license": "SEE LICENSE IN LICENSE",
  "bugs": {
    "url": "https://github.com/RRG314/WorldExplorer3D/issues"
  },
  "homepage": "https://worldexplorer3d.io",
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "esbuild": "^0.25.12",
    "firebase": "^12.9.0",
    "geotiff": "^3.0.5",
    "playwright": "^1.61.0"
  }
}
