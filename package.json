{
  "name": "worldexplorer3d",
  "version": "5.1.0",
  "description": "Browser-based 3D geospatial exploration app using OpenStreetMap-derived data for Earth and destination-mode exploration.",
  "type": "module",
  "main": "three.js",
  "scripts": {
    "dev": "node scripts/serve-local-preview.mjs",
    "candidate:create": "node scripts/local-candidate.mjs create",
    "candidate:serve": "node scripts/local-candidate.mjs serve",
    "candidate:create-and-serve": "node scripts/local-candidate.mjs create-and-serve",
    "capture:5.0-gallery": "node scripts/capture-release-gallery.mjs",
    "verify:source": "node scripts/verification/source.mjs",
    "verify:provider-release": "node scripts/verification/provider-release.mjs",
    "verify:firestore-rules": "firebase emulators:exec --only firestore --project we3d-staging-20260712 \"node --test tests/firestore.rules.security.test.mjs\"",
    "verify:multiplayer": "firebase emulators:exec --only auth,firestore,functions --project we3d-staging-20260712 \"node scripts/verification/multiplayer.mjs\"",
    "verify:world": "node scripts/verification/world.mjs",
    "verify:urban-equipment": "node scripts/verification/urban-equipment.mjs",
    "verify:urban-sandbox": "node scripts/verification/urban-sandbox.mjs",
    "verify:player-state": "node --test tests/player-state-migration.test.mjs",
    "verify:interiors": "node scripts/verification/interiors.mjs",
    "verify:creator-flow": "firebase emulators:exec --only auth,firestore,functions --project we3d-staging-20260712 \"node scripts/verification/creator-flow.mjs\"",
    "verify:world-editor-blocks-desktop": "WE3D_BLOCKS_SCOPE=desktop WE3D_REQUIRE_IMMUTABLE=1 firebase emulators:exec --config firebase.blocks-emulator.json --only auth,firestore,functions --project we3d-staging-20260712 \"node scripts/verification/world-editor-blocks.mjs\"",
    "verify:world-editor-blocks-mobile": "WE3D_BLOCKS_SCOPE=mobile WE3D_REQUIRE_IMMUTABLE=1 firebase emulators:exec --config firebase.blocks-emulator.json --only auth,firestore,functions --project we3d-staging-20260712 \"node scripts/verification/world-editor-blocks.mjs\"",
    "verify:world-editor-blocks-vehicle": "WE3D_BLOCKS_SCOPE=vehicle WE3D_REQUIRE_IMMUTABLE=1 firebase emulators:exec --config firebase.blocks-emulator.json --only auth,firestore,functions --project we3d-staging-20260712 \"node scripts/verification/world-editor-blocks.mjs\"",
    "verify:world-editor-blocks-room": "WE3D_BLOCKS_SCOPE=room WE3D_REQUIRE_IMMUTABLE=1 firebase emulators:exec --config firebase.blocks-emulator.json --only auth,firestore,functions --project we3d-staging-20260712 \"node scripts/verification/world-editor-blocks.mjs\"",
    "verify:block-local-store": "node --test tests/block-local-store-current.test.mjs",
    "verify:block-shared-sync": "node --test tests/shared-block-sync.test.mjs",
    "verify:jfx-player-surface": "node scripts/verification/jfx-player-surface.mjs",
    "verify:environments": "node scripts/verification/environments.mjs",
    "verify:assembled-locations": "node scripts/verification/assembled-locations.mjs",
    "verify:assembled-locations-fallback": "WE3D_FORCE_TRANSPORT_FALLBACK=1 node scripts/verification/assembled-locations.mjs",
    "verify:actors-vehicles": "node scripts/verification/actors-vehicles.mjs",
    "verify:live-gps": "node scripts/verification/live-gps.mjs",
    "verify:live-gps-authority": "node --test tests/live-gps-field-session.test.mjs",
    "verify:shore-fishing": "node scripts/verification/shore-fishing.mjs",
    "verify:fish-population": "node --test tests/fish-population-authority.test.mjs tests/shore-fishing-authority.test.mjs",
    "verify:fishing-loss-recovery": "node scripts/verification/fishing-loss-recovery.mjs",
    "verify:release-scope": "node scripts/verification/release-scope.mjs",
    "verify:release-ready": "node scripts/verification/release-scope.mjs --require-ready",
    "audit:release-claims": "node scripts/verification/public-feature-claims.mjs",
    "verify:release-claims": "node scripts/verification/public-feature-claims.mjs --require-ready",
    "verify:unified-fishing": "node scripts/verification/unified-fishing.mjs",
    "verify:underwater-fish": "node scripts/verification/underwater-fish.mjs",
    "verify:mobile-controls": "node scripts/verification/mobile-controls.mjs",
    "verify:player-reported-blockers": "node scripts/verification/player-reported-blockers.mjs",
    "verify:accessibility-release": "node scripts/verification/accessibility-release.mjs",
    "verify:release-identity": "node scripts/verification/release-identity.mjs",
    "verify:mission-lifecycle": "node scripts/verification/mission-lifecycle.mjs",
    "verify:retention-release": "node scripts/verification/retention-release.mjs",
    "verify:retention-ui": "node scripts/verification/retention-ui.mjs",
    "verify:performance-retention": "node scripts/verification/performance-retention.mjs",
    "verify:deflock": "node --test tests/deflock-data-contract.test.mjs",
    "verify:deflock-live-ui": "node scripts/verification/deflock-live-ui.mjs",
    "verify:walking-encounters": "node scripts/verification/walking-encounters.mjs",
    "verify:ar": "node scripts/verification/ar.mjs",
    "verify:regional-ecology": "node --test tests/baltimore-regional-ecology.test.mjs tests/regional-ecology-expansion.test.mjs",
    "verify:regional-world-richness": "node scripts/verification/regional-world-richness.mjs",
    "verify:field-evidence": "node --test tests/field-evidence-contracts.test.mjs",
    "verify:game-language": "node --test tests/game-facing-language.test.mjs",
    "verify:field-retention": "node --test tests/field-retention.test.mjs",
    "verify:field-retention-ui": "node scripts/verification/field-retention.mjs",
    "verify:explorer-coherence": "node --test tests/explorer-coherence-current.test.mjs",
    "verify:discovery-receipts": "node --test tests/discovery-receipt-endpoint-current.test.mjs",
    "verify:explorer-coherence-browser": "node scripts/verification/explorer-coherence.mjs",
    "verify:regional-guide-new-york": "node scripts/verification/regional-guide-new-york.mjs",
    "verify:creature-quality": "node --test tests/creature-quality.test.mjs",
    "verify:astronomy-catalog": "node --test tests/astronomy-body-catalog-current.test.mjs",
    "verify:astronomy-frames": "node --test tests/astronomy-frames-world-address-current.test.mjs",
    "verify:artifact-runtime": "WE3D_VERIFY_ROOT=dist node scripts/verification/world.mjs",
    "test": "npm run verify:source && npm run verify:world",
    "verify:pr": "npm run verify:source",
    "runtime:verify": "npm test",
    "firebase:config": "node scripts/apply-firebase-config.mjs",
    "firebase:config:production": "node scripts/apply-firebase-config.mjs production",
    "firebase:config:staging": "node scripts/apply-firebase-config.mjs staging",
    "build:hosting": "node scripts/hosting-artifact.mjs build",
    "verify:hosting": "node scripts/hosting-artifact.mjs verify",
    "audit:reachability": "node scripts/audit-hosting-reachability.mjs --strict",
    "audit:assets": "node scripts/audit-hosting-assets.mjs --strict",
    "audit:terrain-provider": "node scripts/audit-terrain-provider.mjs",
    "ground:artifact": "node scripts/build-ground-artifact.mjs",
    "ground:catalog": "node scripts/rebuild-ground-catalog.mjs",
    "ground:worldwide": "node scripts/build-worldwide-ground-artifacts.mjs",
    "ground:datum": "node scripts/run-ground-datum-normalizer.mjs",
    "data:landmarks": "node scripts/update-featured-landmarks.mjs",
    "data:buildings": "node scripts/update-preset-building-metadata.mjs",
    "release:verify": "node scripts/verification/release.mjs",
    "release:finalize": "node scripts/release-finalize.mjs",
    "preview:deploy": "node scripts/firebase-hosting-preview.mjs",
    "preview:promote": "node scripts/firebase-hosting-promote.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RRG314/WorldExplorer3D.git"
  },
  "keywords": [
    "openstreetmap",
    "osm",
    "geospatial",
    "mapping",
    "3d",
    "webgl",
    "threejs",
    "browser-app",
    "world-exploration",
    "web-game",
    "location-based-game",
    "gps",
    "multiplayer",
    "surveillance-awareness"
  ],
  "author": "Steven Reid",
  "license": "SEE LICENSE IN LICENSE",
  "bugs": {
    "url": "https://github.com/RRG314/WorldExplorer3D/issues"
  },
  "homepage": "https://worldexplorer3d.io",
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "esbuild": "^0.25.12",
    "firebase": "^12.9.0",
    "geotiff": "^3.0.5",
    "playwright": "^1.61.0"
  }
}
