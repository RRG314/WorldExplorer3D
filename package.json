{
  "name": "worldexplorer3d",
  "version": "3.1.0",
  "description": "Browser-based 3D geospatial exploration app using OpenStreetMap-derived data for Earth and destination-mode exploration.",
  "type": "module",
  "main": "three.js",
  "scripts": {
    "dev": "node scripts/serve-local-preview.mjs",
    "test": "npm run test:terrain-source && npm run test:district-compiler && npm run test:rules && npm run test:runtime && npm run test:osm-smoke",
    "test:rules": "node scripts/test-rules.mjs",
    "test:css": "node scripts/test-css-integrity.mjs",
    "test:inferred-buildings": "node scripts/test-inferred-building-coverage.mjs",
    "test:module-versions": "node scripts/test-module-version-consistency.mjs",
    "test:maintainability": "node scripts/test-maintainability-guard.mjs",
    "firebase:config": "node scripts/apply-firebase-config.mjs",
    "firebase:config:production": "node scripts/apply-firebase-config.mjs production",
    "firebase:config:staging": "node scripts/apply-firebase-config.mjs staging",
    "build:hosting": "node scripts/hosting-artifact.mjs build",
    "verify:hosting": "node scripts/hosting-artifact.mjs verify",
    "audit:reachability": "node scripts/audit-hosting-reachability.mjs --strict",
    "audit:terrain-provider": "node scripts/audit-terrain-provider.mjs",
    "data:landmarks": "node scripts/update-featured-landmarks.mjs",
    "data:buildings": "node scripts/update-preset-building-metadata.mjs",
    "test:runtime": "node scripts/test-runtime-invariants.mjs",
    "test:runtime-kernel": "node scripts/test-runtime-kernel.mjs",
    "test:transport-controllers": "node scripts/test-transport-controller-registry.mjs",
    "test:platform-services": "node scripts/test-platform-service-registry.mjs",
    "test:geospatial": "node scripts/test-geospatial-data-fabric.mjs",
    "test:functions-runtime": "node scripts/test-functions-runtime.mjs",
    "test:operational-endpoints": "node scripts/test-operational-endpoints.mjs",
    "test:account-service": "node scripts/test-account-service.mjs",
    "test:gameplay-plugins": "node scripts/test-gameplay-plugin-registry.mjs",
    "test:local-data": "node scripts/test-local-data-safety.mjs",
    "test:mobile-controls": "node scripts/test-mobile-controls.mjs",
    "test:plane-interiors": "node scripts/test-plane-interior-lifecycle.mjs",
    "test:editor-multiplayer": "node scripts/test-editor-multiplayer-surfaces.mjs",
    "test:block-builder": "node scripts/test-block-builder-contract.mjs",
    "test:title-planetary": "node scripts/test-title-planetary-launches.mjs",
    "test:session-lifecycle": "node scripts/test-session-lifecycle.mjs",
    "test:surface-contract": "node scripts/test-surface-contract.mjs",
    "test:terrain-source": "node scripts/test-terrain-source-contract.mjs",
    "test:district-compiler": "node scripts/test-district-compiler-contract.mjs",
    "test:overture-source": "node scripts/test-overture-tile-source.mjs && node scripts/test-overture-streaming-source.mjs && node scripts/test-streaming-feature-budget.mjs && node scripts/test-render-provenance.mjs",
    "test:continuous-renderer": "node scripts/test-continuous-renderer.mjs",
    "test:retention": "node scripts/test-release-retention.mjs",
    "test:world-matrix": "node scripts/test-world-matrix.mjs",
    "test:osm-smoke": "node scripts/test-osm-smoke.mjs",
    "runtime:verify": "node scripts/runtime-verify.mjs",
    "release:verify": "node scripts/release-verify.mjs",
    "preview:deploy": "node scripts/firebase-hosting-preview.mjs",
    "preview:promote": "node scripts/firebase-hosting-promote.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RRG314/WorldExplorer3D.git"
  },
  "keywords": [
    "openstreetmap",
    "osm",
    "geospatial",
    "mapping",
    "3d",
    "webgl",
    "threejs",
    "browser-app",
    "world-exploration"
  ],
  "author": "Steven Reid",
  "license": "SEE LICENSE IN LICENSE",
  "bugs": {
    "url": "https://github.com/RRG314/WorldExplorer3D/issues"
  },
  "homepage": "https://worldexplorer3d.io",
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase": "^12.9.0",
    "playwright": "^1.61.0"
  }
}
