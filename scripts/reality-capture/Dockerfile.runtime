# Reuse the security-refreshed immutable toolchain (Node 22.23.4).
FROM us-central1-docker.pkg.dev/we3d-staging-20260712/capture-processing/meshroom@sha256:7fa30a943f988f22128b154e8339402af5b21cb4471ee1f53dd4ebf44c8e5092
USER root
RUN apt-get update && apt-get install -y --no-install-recommends python3-numpy blender-data && rm -rf /var/lib/apt/lists/*
USER 10001
ENV OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 PYTHONUNBUFFERED=1 WE3D_RECONSTRUCTION_REVISION=meshroom-2023.3.0-registration-report-v5
COPY scripts/reality-capture/ /worker/
COPY functions/reality-capture-glb.js /worker/glb-inspection.cjs
COPY functions/reality-capture-diagnostics.js /worker/registration-diagnostics.cjs
RUN node /worker/blender-export-selftest.cjs
