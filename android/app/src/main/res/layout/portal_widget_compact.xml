<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="8dp" android:background="@drawable/portal_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
        <ImageView android:layout_width="0dp" android:layout_weight="1" android:layout_height="32dp"
            android:src="@mipmap/ic_launcher" android:scaleType="fitStart" android:contentDescription="@string/portal_brand" />
        <Button android:textAllCaps="false" android:id="@+id/portal_settings" android:layout_width="48dp" android:layout_height="48dp"
            android:contentDescription="@string/portal_settings" android:text="@string/portal_settings_icon" android:textColor="@color/portal_roam_text" android:backgroundTint="@color/portal_roam_surface" />
    </LinearLayout>
    <TextView android:id="@+id/portal_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/portal_roam_text" android:textStyle="bold" android:textSize="15sp" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/portal_region" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/portal_roam_muted" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/portal_body" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:textColor="@color/portal_roam_text" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" />
    <LinearLayout android:baselineAligned="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp">
        <Button android:textAllCaps="false" android:id="@+id/portal_save" android:layout_width="0dp" android:layout_weight="2" android:layout_height="wrap_content" android:minHeight="48dp"
            android:textColor="@color/portal_roam_text" android:backgroundTint="@color/portal_roam_surface" android:textSize="10sp" />
        <ImageButton android:id="@+id/portal_open" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
            android:contentDescription="@string/portal_open_place" android:src="@drawable/portal_open_icon"
            android:background="@drawable/portal_icon_button" android:padding="12dp" android:scaleType="centerInside" />
    </LinearLayout>
    <Button android:textAllCaps="false" android:id="@+id/portal_investigate" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <Button android:textAllCaps="false" android:id="@+id/portal_fact_next" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <Button android:textAllCaps="false" android:id="@+id/portal_trail" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <TextView android:id="@+id/portal_status" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/portal_roam_muted" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
